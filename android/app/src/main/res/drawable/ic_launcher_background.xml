<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background layer: pale blue-white (#F0F5FE), matching the
     flat backdrop baked into medicine-reminder-icon.png's own squircle tile,
     full-bleed. The foreground PNG (ic_launcher_foreground) is deliberately
     inset to ~62% of its canvas with transparent padding around it, so it
     sits as a clean badge on this background regardless of which mask shape
     (circle, squircle, rounded-square, etc.) the launcher applies on top of
     this plus the foreground layer — this itself stays an unmasked,
     full-bleed rectangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#F0F5FE"
        android:pathData="M0,0h108v108h-108z" />
</vector>
