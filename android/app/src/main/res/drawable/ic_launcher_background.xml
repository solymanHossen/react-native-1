<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background layer: solid brand blue (#395886 — the same
     `action.light.base` token the rest of the app uses, not a new one-off
     color), full-bleed. The foreground PNG (ic_launcher_foreground) is
     deliberately inset to ~62% of its canvas with transparent padding around
     it, so it sits as a clean badge on this background regardless of which
     mask shape (circle, squircle, rounded-square, etc.) the launcher applies
     on top of this plus the foreground layer — this itself stays an
     unmasked, full-bleed rectangle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#395886"
        android:pathData="M0,0h108v108h-108z" />
</vector>
